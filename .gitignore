# Ignore all *.zwc files. These are compiled files generated by znap
home/dot_config/**/*.zwc

# Ignore colima except for the configuration file
home/dot_config/colima/*
!home/dot_config/colima/default/colima.yaml

# Ignore copilot except for the configuration file
home/dot_config/copilot/*
!home/dot_config/copilot/config.json

# Ignore docker except for the configuration file
home/dot_config/docker/*
!home/dot_config/docker/config.json

# Ignore infracost except for the configuration file
home/dot_config/private_infracost/*
!home/dot_config/private_infracost/configuration.yml
